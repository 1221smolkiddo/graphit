{
  "name": "graphit-cmp",
  "version": "1.0.0",
  "description": "Local project memory, code intelligence and MCP server for AI coding agents. Preserves canonical source evidence, durable memory, provider-neutral handoff and token-budgeted context.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1221smolkiddo/graphit.git"
  },
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "model-context-protocol",
    "code-intelligence",
    "tree-sitter",
    "context",
    "memory",
    "handoff",
    "sqlite",
    "retrieval",
    "rag",
    "codex",
    "claude",
    "copilot"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "graphit": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "docs/GETTING_STARTED.md",
    "docs/CLI.md",
    "docs/MCP.md",
    "docs/ARCHITECTURE.md",
    "docs/MEMORY.md",
    "docs/RETRIEVAL.md",
    "docs/PORTABILITY.md",
    "docs/DATA_PRESERVATION.md",
    "docs/RELEASE.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build -w @graphit/core && npm run build -w @graphit/storage && npm run build -w @graphit/memory && npm run build -w @graphit/codegraph && npm run build -w @graphit/indexer && npm run build -w @graphit/retrieval && npm run build -w @graphit/context && npm run build -w @graphit/mcp && npm run build -w @graphit/cli",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "graphit": "node packages/cli/dist/index.js",
    "mcp:smoke": "node examples/mcp-smoke.mjs",
    "verify:packed": "node scripts/verify-packed.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "audit:pack": "node scripts/audit-pack.mjs",
    "prepack": "npm run build && node scripts/prepare-package.mjs",
    "prepublishOnly": "npm test && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "better-sqlite3": "12.11.1",
    "graphit-zod-v4": "npm:zod@^4.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.15.30",
    "eslint": "^10.11.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
